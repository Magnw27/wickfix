# ============ Konfigurasi AI Chat App ============

# API key provider AI (OpenRouter/OmniRoute/9Router) — wajib
OPENROUTER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Base URL provider (endpoint /v1)
OPENROUTER_BASE_URL=https://pry-resend-atrophy.ngrok-free.dev/v1

# Nama aplikasi — dikirim ke provider sebagai header X-Title
APP_TITLE=AI Chat

# URL publik aplikasi (URL Cloudflare Tunnel / domain Anda).
# Dikirim ke provider sebagai header HTTP-Referer.
# Biarkan kosong jika belum ada domain publik.
APP_REFERER=https://contoh.trycloudflare.com

# Model default untuk dropdown model
DEFAULT_MODEL=pemula

# Model untuk fitur "generate gambar" (butuh provider image gen yang terhubung)
DEFAULT_IMAGE_MODEL=antigravity/gemini-3.1-flash-image

# ============ Server ============

# Port server (OmniRoute/9Router memakai 20128; app ini default 8000)
PORT=8000

# ============ Cloudflare Tunnel / Proxy stability ============

# Interval heartbeat (SSE ping) dalam milidetik.
# 15000 = setiap 15 detik, agar Cloudflare tidak memutus koneksi streaming.
HEARTBEAT_MS=15000

# ============ Rate limiting ============

# Jendela waktu (ms) dan jumlah maksimum request per IP
CHAT_RATE_WINDOW_MS=60000
CHAT_RATE_MAX=30
GENERAL_RATE_WINDOW_MS=60000
GENERAL_RATE_MAX=120

# ============ Cache ============

# TTL cache daftar model (ms)
MODELS_CACHE_TTL_MS=600000